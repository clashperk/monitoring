{
  "uid": "trackers",
  "title": "Trackers",
  "tags": [
    "clashperk",
    "trackers"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 39,
  "graphTooltip": 1,
  "time": {
    "from": "now-12h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Up",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Services that pushed metrics in the last 5 minutes, out of 4.",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "count(max by (service)(last_over_time(tracker_maintenance{job=\"radar\"}[5m]))) or vector(0)",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Clash API",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Paused while the Clash API is in maintenance.",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "max(tracker_maintenance{job=\"radar\"})",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Running",
                  "color": "green"
                },
                "1": {
                  "text": "Paused",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Calls/s",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Clash API calls per second, all services.",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "sum(rate(tracker_api_requests_total{job=\"radar\"}[5m]))",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "API p95",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Time for one Clash API call, all services.",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "histogram_quantile(0.95, sum by (vmrange)(rate(tracker_api_request_duration_seconds_bucket{job=\"radar\"}[5m])))",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Failed calls (1h)",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Throttled (429) or failed calls as a share of all calls over the last hour. A few HTTP/2 connection resets are normal; 404s (banned or deleted tags) don't count.",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "(sum(increase_pure(tracker_api_requests_total{job=\"radar\",status=~\"throttled|failed\"}[1h])) or vector(0)) / sum(increase_pure(tracker_api_requests_total{job=\"radar\"}[1h]))",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.001
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Write errors (1h)",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Failed Mongo or ClickHouse writes over the last hour.",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "sum(increase_pure(tracker_write_errors_total{job=\"radar\"}[1h])) or vector(0)",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Services",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "One row per service. Last cycle and items per cycle are the last finished full sweep (\"in progress\" until the first after a restart; clan-history takes days).",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "max by (service)(tracker_cycle_duration_seconds{job=\"radar\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "max by (service)(tracker_cycle_items{job=\"radar\"})",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "sum by (service)(rate(tracker_batch_items_total{job=\"radar\"}[5m]))",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "sum by (service)(rate(tracker_api_requests_total{job=\"radar\"}[5m]))",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "histogram_quantile(0.95, sum by (service, vmrange)(rate(tracker_api_request_duration_seconds_bucket{job=\"radar\"}[5m])))",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "max by (service)(process_resident_memory_bytes{job=\"radar\"})",
          "format": "table",
          "instant": true,
          "refId": "F"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "service": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6
            },
            "renameByName": {
              "service": "Service",
              "Value #A": "Last cycle",
              "Value #B": "Items per cycle",
              "Value #C": "Items/s",
              "Value #D": "Calls/s",
              "Value #E": "API p95",
              "Value #F": "Memory"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Service",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last cycle"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "noValue",
                "value": "in progress"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Items per cycle"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "noValue",
                "value": "in progress"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Items/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "noValue",
                "value": "0"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Calls/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "noValue",
                "value": "0"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "API p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "noValue",
                "value": "-"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "noValue",
                "value": "-"
              }
            ]
          }
        ]
      }
