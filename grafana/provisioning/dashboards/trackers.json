          },
          "expr": "max by (service)(tracker_cycle_duration_seconds{job=\"radar\"})",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true,
          "sortBy": "Mean",
          "sortDesc": true
