    {
      "type": "stat",
      "title": "Clan loop",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Average time of one full clan pass over the last hour, slowest fork.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "max by (loop)(increase_pure(worker_loop_duration_seconds_sum{job=\"worker\",loop=\"clan\"}[1h]) / increase_pure(worker_loop_duration_seconds_count{job=\"worker\",loop=\"clan\"}[1h]))",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 600
              },
              {
                "color": "red",
                "value": 1200
              }
            ]
          }
        },
        "overrides": []
