      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "(sum(rate(discord_interaction_response_age_seconds_count{job=\"bot\",outcome=\"unknown\"}[$__rate_interval])) or vector(0)) / sum(rate(discord_interaction_response_age_seconds_count{job=\"bot\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
