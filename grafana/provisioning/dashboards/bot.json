{
  "uid": "bot",
  "title": "Bot",
  "tags": [
    "clashperk",
    "bot"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 39,
  "graphTooltip": 1,
