    {
      "type": "table",
      "title": "Slash commands: slow and unknown responses",
      "id": 23,
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "description": "Per command over the selected range. Slow = answered after 2 s; unknown = 10062. Sorted by % slow or unknown.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "sum by (command)(increase_pure(discord_command_responses_total{job=\"bot\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "sum by (command)(increase_pure(discord_command_responses_total{job=\"bot\",result=\"slow\"}[$__range])) or sum by (command)(increase_pure(discord_command_responses_total{job=\"bot\"}[$__range])) * 0",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "sum by (command)(increase_pure(discord_command_responses_total{job=\"bot\",result=\"unknown\"}[$__range])) or sum by (command)(increase_pure(discord_command_responses_total{job=\"bot\"}[$__range])) * 0",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "sum by (command)(increase_pure(discord_command_responses_total{job=\"bot\",result=\"error\"}[$__range])) or sum by (command)(increase_pure(discord_command_responses_total{job=\"bot\"}[$__range])) * 0",
          "refId": "D",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "(100 * sum by (command)(increase_pure(discord_command_responses_total{job=\"bot\",result=~\"slow|unknown\"}[$__range])) / sum by (command)(increase_pure(discord_command_responses_total{job=\"bot\"}[$__range]))) or sum by (command)(increase_pure(discord_command_responses_total{job=\"bot\"}[$__range])) * 0",
