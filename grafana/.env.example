# generate with: openssl rand -hex 24
GF_ADMIN_PASSWORD=
# Google OAuth web client; redirect URI https://grafana.clashperk.com/login/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# same values as ../victoria-metrics/.env
VM_USER=
VM_PASSWORD=
# hosts outside the compose network only (compose sets its own)
VM_URL=https://metrics.clashperk.com
